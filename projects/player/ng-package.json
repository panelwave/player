{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/player",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": ["json-logic-js", "uqr"],
  "assets": [
    {
      "glob": "**/*",
      "input": "src/assets",
      "output": "src/assets",
      "ignore": ["**/amespro-*"]
    },
    {
      "glob": "{panelwave-embed.js,panelwave-embed.mjs,panelwave-embed.d.ts,core.d.ts}",
      "input": "embed-build",
      "output": "embed"
    }
  ]
}